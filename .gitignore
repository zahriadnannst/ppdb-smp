# ========================================
# PPDB SMP - .gitignore
# ========================================

# ---- Uploads (file yang diupload user) ----
uploads/
!uploads/.gitkeep

# ---- Environment & Config sensitif ----
.env
config/config.local.php

# ---- IDE & Editor ----
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/

# ---- OS Files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
logs/
error_log

# ---- Temporary Files ----
*.tmp
*.temp
*.swp
*.swo
*~
.cache/

# ---- Dependencies (jika pakai composer) ----
/vendor/
composer.lock

# ---- Node modules (jika pakai npm) ----
node_modules/
package-lock.json

# ---- Build output ----
/dist/
/build/

# ---- Database dumps (sensitif) ----
*.sql
!database/schema.sql
!database/seed_data.sql
!database/create_jadwal_jalur.sql
!database/migrations/
!database/migrations/*.sql

# ---- Backup files ----
*.bak
*.backup
*_backup*

# ---- Session files ----
sess_*
